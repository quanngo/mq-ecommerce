# Fullstack workspace project registry.
# Edit this file to add/remove/rename projects, then re-run ./setup.sh to sync
# and ./start.sh to (re)launch. See README.md for full docs.
#
# Every project needs 4 lines: KEY, NAME, REPO, START (index starts at 1).
# KEY must be unique across ALL frontend + backend projects (used as the
# clone folder name, the PM2 process name, and the ./start.sh <key> argument).
#
# Optional per project:
#   <TYPE>_DIR_<N>   folder relative to workspace/<type>/ instead of <key>;
#                    "." = workspace/<type> itself.
#   <TYPE>_REPO_<N>  may be empty when the project lives in this repo
#                    (setup.sh then skips the clone/pull).

# --- FRONTEND PROJECTS ---
FRONTEND_COUNT=1

# Admin app (React + Vite, plain JS): workspace/frontend, dev server on :8088.
FRONTEND_KEY_1=admin
FRONTEND_NAME_1="MQ E-commerce Admin"
FRONTEND_REPO_1=
FRONTEND_DIR_1=.
FRONTEND_START_1="npm run dev"

# --- BACKEND PROJECTS ---
BACKEND_COUNT=1

# Go marketplace order sync service + admin API: workspace/backend, :9091.
BACKEND_KEY_1=api
BACKEND_NAME_1="MQ E-commerce Integration Service"
BACKEND_REPO_1=
BACKEND_DIR_1=.
BACKEND_START_1="go run main.go"
